{
  "realm": "ifs",
  "enabled": true,
  "displayName": "InfraFlowSculptor",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "ifs-web",
      "name": "IFS Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "rootUrl": "http://localhost:4200",
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email", "ifs-claims"]
    },
    {
      "clientId": "ifs-api",
      "name": "IFS API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "ifs-scalar",
      "name": "IFS Scalar",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "rootUrl": "http://localhost:5257",
      "redirectUris": [
        "http://localhost:5257/scalar/*",
        "https://localhost:7246/scalar/*"
      ],
      "webOrigins": [
        "http://localhost:5257",
        "https://localhost:7246"
      ],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email", "ifs-claims"]
    }
  ],
  "roles": {
    "client": {
      "ifs-api": [
        { "name": "Ifs.Support", "composite": false },
        { "name": "Ifs.CatalogEditor", "composite": false },
        { "name": "Ifs.PlatformAdmin", "composite": false }
      ]
    }
  },
  "clientScopes": [
    {
      "name": "ifs-claims",
      "description": "IFS organization and user claims",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "oid claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "oid",
            "claim.name": "oid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tid claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tid",
            "claim.name": "tid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "amr claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "amr",
            "claim.name": "amr",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "ifs-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ifs-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "ifs-api client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "ifs-api",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
