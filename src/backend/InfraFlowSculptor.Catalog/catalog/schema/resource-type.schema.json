{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infraflowsculptor.local/schema/resource-type.schema.json",
  "title": "Descripteur de type de ressource IFS",
  "type": "object",
  "required": [
    "type", "labels", "category", "icon", "armType", "availableFrom", "documentationUrl",
    "verifiedAgainstDocsOn", "naming", "properties", "fixedValues", "children", "identities",
    "links", "outputs", "lifecycle", "roles", "roleEquivalences", "dataAccess", "exposure",
    "diagnostics", "applicationSettings", "languageSupport", "generation", "deprecations",
    "privateDnsZones", "requiredNetworkRules", "recommendedAlerts", "pricing", "drift"
  ],
  "properties": {
    "type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "labels": { "$ref": "#/$defs/labels" },
    "category": { "enum": ["observability", "security", "data", "compute", "platform"] },
    "icon": { "type": "string", "minLength": 1 },
    "armType": { "type": "string", "pattern": "^[A-Za-z0-9.]+/.+$" },
    "availableFrom": { "enum": ["lot1"] },
    "documentationUrl": { "type": "string", "format": "uri" },
    "verifiedAgainstDocsOn": { "type": "string", "format": "date" },
    "naming": { "$ref": "#/$defs/naming" },
    "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
    "fixedValues": { "type": "array", "items": { "$ref": "#/$defs/fixedValue" } },
    "children": { "type": "array", "items": { "$ref": "#/$defs/child" } },
    "identities": {
      "type": "object",
      "required": ["system", "userAssignedMax"],
      "properties": {
        "system": { "type": "boolean" },
        "userAssignedMax": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "links": {
      "type": "object",
      "required": ["asSource", "asTarget", "required"],
      "properties": {
        "asSource": { "type": "array", "items": { "$ref": "#/$defs/linkKind" }, "uniqueItems": true },
        "asTarget": { "type": "array", "items": { "$ref": "#/$defs/linkKind" }, "uniqueItems": true },
        "required": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "cardinality"],
            "properties": {
              "kind": { "$ref": "#/$defs/linkKind" },
              "cardinality": { "enum": ["one", "oneOrMany"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } },
    "lifecycle": {
      "type": "object",
      "required": ["family"],
      "properties": { "family": { "enum": ["data", "state", "authorizationConfiguration"] } },
      "additionalProperties": false
    },
    "roles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "roleEquivalences": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
    },
    "dataAccess": {
      "type": "object",
      "required": ["supported", "levels", "databaseEngine"],
      "properties": {
        "supported": { "type": "boolean" },
        "levels": { "type": "array", "items": { "type": "string" } },
        "databaseEngine": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "exposure": {
      "type": "object",
      "required": ["modes", "privateGroupIds", "privateDnsZones", "conditions"],
      "properties": {
        "modes": { "type": "array", "items": { "enum": ["Public", "Restricted", "Private"] }, "uniqueItems": true },
        "privateGroupIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "privateDnsZones": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "conditions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "required": ["supported"],
      "properties": { "supported": { "type": "boolean" } },
      "additionalProperties": false
    },
    "applicationSettings": {
      "type": "object",
      "required": ["destination"],
      "properties": { "destination": { "enum": ["none", "environmentVariables", "appConfiguration"] } },
      "additionalProperties": false
    },
    "languageSupport": {
      "type": "object",
      "required": ["Bicep", "Terraform", "Pulumi"],
      "properties": {
        "Bicep": { "$ref": "#/$defs/languageSupportLevel" },
        "Terraform": { "$ref": "#/$defs/languageSupportLevel" },
        "Pulumi": { "$ref": "#/$defs/languageSupportLevel" }
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "required": ["Bicep"],
      "properties": {
        "Bicep": {
          "type": "object",
          "required": ["module", "versionPin", "map"],
          "properties": {
            "module": { "type": "string", "pattern": "^br/public:avm/" },
            "versionPin": { "type": "string", "minLength": 1 },
            "map": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
            "parameterObjects": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "$ref": "#/$defs/generationObjectValue" }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "deprecations": { "type": "array", "items": { "$ref": "#/$defs/deprecation" } },
    "privateDnsZones": { "type": "array", "items": { "$ref": "#/$defs/privateDnsZone" } },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
    "requiredNetworkRules": { "type": "array", "items": { "$ref": "#/$defs/networkRule" } },
    "recommendedAlerts": { "type": "array", "items": { "$ref": "#/$defs/alert" } },
    "pricing": { "$ref": "#/$defs/pricing" },
    "drift": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "generationObjectValue": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ref"],
          "properties": { "ref": { "type": "string", "minLength": 1 } },
          "maxProperties": 1,
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["const"],
          "properties": { "const": { "type": ["string", "number", "boolean"] } },
          "maxProperties": 1,
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["enumRef", "values"],
          "properties": {
            "enumRef": { "type": "string", "minLength": 1 },
            "values": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": ["string", "number", "boolean"] }
            }
          },
          "maxProperties": 2,
          "additionalProperties": false
        }
      ]
    },
    "labels": {
      "type": "object",
      "required": ["fr", "en"],
      "properties": { "fr": { "type": "string" }, "en": { "type": "string" } },
      "additionalProperties": false
    },
    "naming": {
      "type": "object",
      "required": ["abbreviation", "allowed", "case", "separators", "forbidConsecutiveSeparators", "minLength", "maxLength", "firstChar", "lastChar", "uniqueness", "availabilityDomain"],
      "properties": {
        "abbreviation": { "type": "string", "minLength": 1 },
        "allowed": { "type": "string", "minLength": 1 },
        "case": { "enum": ["lower", "upper", "mixed"] },
        "separators": { "type": "array", "items": { "type": "string", "maxLength": 1 } },
        "forbidConsecutiveSeparators": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 1 },
        "maxLength": { "type": "integer", "minimum": 1 },
        "firstChar": { "type": "string" },
        "lastChar": { "type": "string" },
        "uniqueness": { "enum": ["global", "resourceGroup", "parent"] },
        "availabilityDomain": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "property": {
      "type": "object",
      "required": ["name", "labels", "kind", "overridable"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "labels": { "$ref": "#/$defs/labels" },
        "kind": {
          "enum": ["boolean", "integer", "number", "string", "enum", "reference", "array", "object"],
          "description": "Pour array, la valeur est un tableau JSON; pour object, un objet JSON. Le descripteur fixe le type du conteneur; ses éléments et membres imbriqués peuvent être des scalaires, tableaux ou objets et sont stockés comme arbre relationnel typé. `items` permet de préciser le type et le format des éléments d'un tableau homogène."
        },
        "items": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["boolean", "integer", "number", "string", "enum", "reference", "object"] },
            "format": { "enum": ["ipv4Cidr"] },
            "members": { "type": "array", "items": { "$ref": "#/$defs/propertyMember" }, "minItems": 1 },
            "uniqueBy": { "type": "string", "minLength": 1 },
            "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } }
          },
          "allOf": [
            {
              "if": { "required": ["members"] },
              "then": { "properties": { "kind": { "const": "object" } } }
            },
            {
              "if": { "properties": { "kind": { "const": "object" } } },
              "then": { "required": ["members"] }
            },
            {
              "if": { "required": ["uniqueBy"] },
              "then": { "properties": { "kind": { "const": "object" } } }
            },
            {
              "if": { "required": ["constraints"] },
              "then": { "properties": { "kind": { "const": "object" } } }
            }
          ],
          "additionalProperties": false
        },
        "allowedFrom": { "$ref": "#/$defs/allowedValuesSource" },
        "values": { "type": "array", "items": {} },
        "default": {},
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "overridable": { "type": "boolean" },
        "lockedAfterPublish": { "type": "boolean" },
        "irreversible": {
          "type": "object",
          "required": ["from", "to"],
          "properties": { "from": {}, "to": {} },
          "additionalProperties": false
        },
        "deprecatedValues": { "type": "array", "items": { "type": "string" } },
        "condition": { "type": "string" },
        "description": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "required": ["items"] },
          "then": { "properties": { "kind": { "const": "array" } } }
        },
        {
          "if": {
            "required": ["items"],
            "properties": {
              "items": {
                "required": ["format"],
                "properties": { "format": { "const": "ipv4Cidr" } }
              }
            }
          },
          "then": { "properties": { "items": { "properties": { "kind": { "const": "string" } } } } }
        }
      ],
      "additionalProperties": false
    },
    "propertyMember": {
      "type": "object",
      "required": ["name", "kind", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["boolean", "integer", "number", "string", "enum", "reference"] },
        "required": { "type": "boolean" },
        "values": { "type": "array", "items": {} },
        "forbiddenValues": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "format": { "enum": ["ipv4Cidr"] }
      },
      "allOf": [
        {
          "if": { "required": ["format"] },
          "then": { "properties": { "kind": { "const": "string" } } }
        }
      ],
      "additionalProperties": false
    },
    "allowedValuesSource": {
      "type": "object",
      "required": ["linkKind", "targetProperty", "targetMember", "implicitValues"],
      "properties": {
        "linkKind": { "$ref": "#/$defs/linkKind" },
        "targetProperty": { "type": "string", "minLength": 1 },
        "targetMember": { "type": "string", "minLength": 1 },
        "implicitValues": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "constraint": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind", "left", "operator", "right"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 47, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,46}$(?![\\s\\S])" },
            "kind": { "const": "compare" },
            "left": { "type": "string", "minLength": 1 },
            "operator": { "enum": ["lessThanOrEqual"] },
            "right": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "properties", "tuples"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 47, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,46}$(?![\\s\\S])" },
            "kind": { "const": "allowedTuples" },
            "properties": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2, "maxItems": 4, "uniqueItems": true },
            "tuples": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": ["string", "number", "boolean"] } }
            },
            "when": {
              "type": "object",
              "required": ["property", "equals"],
              "properties": {
                "property": { "type": "string", "minLength": 1 },
                "equals": { "type": ["string", "number", "boolean"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fixedValue": {
      "type": "object",
      "required": ["name", "value", "labels"],
      "properties": { "name": { "type": "string" }, "value": {}, "labels": { "$ref": "#/$defs/labels" } },
      "additionalProperties": false
    },
    "child": {
      "type": "object",
      "required": ["type", "labels", "naming", "properties"],
      "properties": {
        "type": { "type": "string" },
        "labels": { "$ref": "#/$defs/labels" },
        "naming": { "$ref": "#/$defs/naming" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }
      },
      "additionalProperties": false
    },
    "linkKind": { "enum": ["Hosting", "Logging", "Diagnostics", "Telemetry", "ImagePull", "HostStorage", "ConfigurationRead", "Access", "DataAccess", "ValueDependency", "SecretRead"] },
    "output": {
      "type": "object",
      "required": ["name", "description", "sensitive", "computableFromName"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "sensitive": { "type": "boolean" },
        "condition": { "type": "string" },
        "computableFromName": { "type": "boolean" },
        "pattern": { "type": "string" }
      },
      "additionalProperties": false
    },
    "languageSupportLevel": { "enum": ["full", "partial", "none"] },
    "deprecation": {
      "type": "object",
      "required": ["value", "deprecatedOn", "refusedOn"],
      "properties": {
        "value": { "type": "string" },
        "deprecatedOn": { "type": ["string", "null"], "format": "date" },
        "refusedOn": { "type": ["string", "null"], "format": "date" }
      },
      "additionalProperties": false
    },
    "privateDnsZone": {
      "type": "object",
      "required": ["groupId", "zoneName"],
      "properties": { "groupId": { "type": "string" }, "zoneName": { "type": "string" } },
      "additionalProperties": false
    },
    "networkRule": {
      "type": "object",
      "required": ["usage", "protocol", "port"],
      "properties": { "usage": { "type": "string" }, "protocol": { "type": "string" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 } },
      "additionalProperties": false
    },
    "alert": {
      "type": "object",
      "required": ["metric", "aggregation", "threshold", "severity"],
      "properties": {
        "metric": { "type": "string" },
        "aggregation": { "type": "string" },
        "threshold": { "type": "number" },
        "severity": { "type": "integer", "minimum": 0, "maximum": 4 }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "required": ["source", "meters", "assumptions", "estimated"],
      "properties": {
        "source": { "enum": ["azure-retail-prices"] },
        "meters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["serviceName", "productName", "meterName"],
            "properties": { "serviceName": { "type": "string" }, "productName": { "type": "string" }, "meterName": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "unit", "default"],
            "properties": { "name": { "type": "string" }, "unit": { "type": "string" }, "default": { "type": "number", "minimum": 0 } },
            "additionalProperties": false
          }
        },
        "estimated": { "type": "boolean" },
        "unestimatedReason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
