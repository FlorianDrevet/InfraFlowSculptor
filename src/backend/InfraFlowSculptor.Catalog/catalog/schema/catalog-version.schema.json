{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infraflowsculptor.local/schema/catalog-version.schema.json",
  "title": "Version de catalogue IFS",
  "type": "object",
  "required": ["version", "status", "publishedAt", "supportEndsAt", "notes", "verifiedAgainstDocsOn"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}-[a-z0-9-]+$" },
    "status": { "enum": ["draft", "published", "deprecated"] },
    "publishedAt": { "type": "string", "format": "date" },
    "supportEndsAt": { "type": ["string", "null"], "format": "date" },
    "notes": { "type": "string" },
    "verifiedAgainstDocsOn": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
