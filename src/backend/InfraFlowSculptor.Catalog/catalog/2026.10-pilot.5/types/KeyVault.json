    "conditions": []
  },
  "diagnostics": {
    "supported": true
  },
  "applicationSettings": {
    "destination": "none"
  },
  "languageSupport": {
    "Bicep": "full",
    "Terraform": "none",
    "Pulumi": "none"
  },
  "generation": {
