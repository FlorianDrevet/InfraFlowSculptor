      "overridable": true,
      "default": "EntraSeule",
      "values": [
        "EntraSeule",
        "EntraEtSql"
      ]
    },
    {
      "name": "administratorLogin",
      "labels": {
        "fr": "Login administrateur SQL",
        "en": "SQL administrator login"
      },
      "kind": "string",
      "overridable": true,
      "default": "sqladmin",
      "minimum": 1,
      "maximum": 128,
      "condition": "requiredWhen:authentication=EntraEtSql"
    }
  ],
  "fixedValues": [
    {
      "name": "minimalTlsVersion",
