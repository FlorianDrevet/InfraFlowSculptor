          "kind": "enum",
          "overridable": true,
          "default": "Geo",
          "values": [
            "Local",
            "Zone",
            "Geo"
          ]
        },
        {
          "name": "collation",
          "labels": {
            "fr": "Classement",
            "en": "Collation"
