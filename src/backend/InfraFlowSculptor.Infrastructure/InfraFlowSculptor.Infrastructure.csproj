<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>InfraFlowSculptor.Infrastructure</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Communication.Email" />
        <PackageReference Include="Azure.Identity" />
        <PackageReference Include="Azure.Messaging.ServiceBus" />
        <PackageReference Include="Azure.Storage.Blobs" />
        <PackageReference Include="Microsoft.Azure.StackExchangeRedis" />
        <PackageReference Include="StackExchange.Redis" />
        <PackageReference Include="MailKit" />
        <PackageReference Include="Microsoft.Extensions.Azure" />
        <PackageReference Include="AspNetCore.HealthChecks.AzureServiceBus" />
        <PackageReference Include="AspNetCore.HealthChecks.Azure.Storage.Blobs" />
        <PackageReference Include="AspNetCore.HealthChecks.Redis" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="EFCore.NamingConventions" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Email\Templates\Invitation.*.html">
            <WithCulture>false</WithCulture>
            <LogicalName>InfraFlowSculptor.Infrastructure.Email.Templates.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Email\Templates\Invitation.*.txt">
            <WithCulture>false</WithCulture>
            <LogicalName>InfraFlowSculptor.Infrastructure.Email.Templates.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\InfraFlowSculptor.Application\InfraFlowSculptor.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
</Project>
